{
  "name": "claude-md-plugin",
  "version": "4.1.0",
  "description": "Code-First + Spec-as-Contract 문서-코드 동기화 플러그인. 소스코드가 Source of Truth, CLAUDE.md는 코드가 만족해야 할 계약. /impl로 계약 정의, /compile로 코드 생성, /validate로 계약 위반 보고, /decompile로 계약 추출, /bugfix로 3계층 버그 추적, /impl-review로 품질 리뷰, /impact로 변경 영향 분석, /diff-spec으로 버전 비교, /status로 건강도 대시보드, /refactor로 모듈 분할/병합",
  "author": {
    "name": "jhk"
  },
  "repository": "https://github.com/0pg/cc-marketplace",
  "homepage": "https://github.com/0pg/cc-marketplace/tree/main/plugins/claude-md-plugin",
  "license": "MIT",
  "keywords": [
    "claude-md",
    "documentation",
    "source-of-truth",
    "code-sync",
    "code-generation"
  ],
  "skills": [
    "./skills/impl",
    "./skills/compile",
    "./skills/decompile",
    "./skills/validate",
    "./skills/bugfix",
    "./skills/impl-review",
    "./skills/impact",
    "./skills/diff-spec",
    "./skills/status",
    "./skills/refactor",
    "./skills/tree-parse"
  ],
  "agents": [
    "./agents/compiler.md",
    "./agents/test-designer.md",
    "./agents/debug-layer-analyzer.md",
    "./agents/debugger.md",
    "./agents/decompiler.md",
    "./agents/dep-explorer.md",
    "./agents/impl.md",
    "./agents/impl-reviewer.md",
    "./agents/validator.md",
    "./agents/issue-verifier.md",
    "./agents/violation-reporter.md"
  ],
  "commands": [
    "./commands/dev.md",
    "./commands/project-setup.md",
    "./commands/convention-update.md"
  ],
  "hooks": [
    "./hooks/hooks.json"
  ]
}
